# Server port
PORT=5000

# MongoDB connection string
# Local example:      mongodb://127.0.0.1:27017/portfolio
# Atlas example:       mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio
MONGO_URI=your_mongodb_connection_string

# Secret used to sign admin JWT tokens - use a long random string
JWT_SECRET=your_secret_key

# Comma-separated list of origins allowed to call this API
# Example for local dev: http://localhost:5173
# Add your deployed frontend URL here too once you deploy
CLIENT_ORIGIN=http://localhost:5173
